# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bde_wave

# Secret used to sign admin JSON Web Tokens, at least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me

# Credentials of the first admin, created at API startup only if the Admin table is empty.
# The password needs at least 12 characters. Later admins are managed through the API.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Public URL of the website (used in links and CORS)
PUBLIC_SITE_URL=http://localhost:5173

# Where partnership requests are sent
PARTNERSHIP_EMAIL=partnership@example.com

# Public contact address of the club
CLUB_EMAIL=contact@example.com
