# Copy this file to .env and fill in real values. Never commit .env.
# One file serves two modes: `pnpm dev:*` on the host, and `docker compose` (see CLAUDE.md, "Docker").
# Local Docker: `pnpm docker:dev` builds and starts the stack on localhost.
# Local Docker, plain `docker compose up` on localhost: uncomment the COMPOSE_FILE line at the end of this file (never on the server).
# Docker values are marked [docker]. Generate secrets with: openssl rand -hex 24

# --- Database (PostgreSQL) ---

# [docker] Name of the PostgreSQL superuser created on the first start of the db container.
POSTGRES_USER=bde
# [docker] Its password. Letters and digits only (it is placed in a URL).
POSTGRES_PASSWORD=change-me
# [docker] Name of the database created on the first start of the db container.
POSTGRES_DB=bde_wave
# Connection string for `pnpm dev:api` and Prisma on the host; same user, password and database as above.
# Docker compose ignores this line and builds its own from the POSTGRES_ values (host bde-site-db).
DATABASE_URL=postgresql://bde:change-me@localhost:5432/bde_wave

# --- API ---

# Port the API listens on (the Docker image always uses 3000).
PORT=3000
# Secret used to sign admin sessions, at least 32 characters (openssl rand -base64 48).
JWT_SECRET=change-me
# E-mail of the first admin, created at API startup only if the Admin table is empty.
ADMIN_EMAIL=admin@example.com
# Password of the first admin, at least 12 characters. Later admins are managed in the admin panel.
ADMIN_PASSWORD=change-me
# Public URL of the website: the only origin allowed by CORS. In production, e.g. https://bde.example.com
PUBLIC_SITE_URL=http://localhost:5173
# Public URL of the API, used to build the URLs of uploaded images. In production, usually the same as PUBLIC_SITE_URL.
PUBLIC_API_URL=http://localhost:3000
# Folder of the uploaded images on the host (relative to apps/api). Docker compose always uses the volume /data/uploads.
UPLOAD_DIR=./uploads

# --- Contact addresses ---

# Where partnership requests are sent (used by the API side).
PARTNERSHIP_EMAIL=partnership@example.com
# Public contact address of the club (used by the API side).
CLUB_EMAIL=contact@example.com

# --- Frontend: only VITE_ variables reach the browser, and Vite bakes them in at build time ---

# Base URL of the API called by the site. Leave it empty in production when the proxy serves /api and /uploads on the site's own domain.
VITE_API_URL=http://localhost:3000
# Target of the "Devenir partenaire" mailto: link. Same value as PARTNERSHIP_EMAIL.
VITE_PARTNERSHIP_EMAIL=partnership@example.com
# Target of the "Créer ton club" mailto: link. Same value as CLUB_EMAIL.
VITE_CLUB_EMAIL=contact@example.com

# --- Local Docker only ---

# Makes a plain `docker compose up --build -d` also load docker-compose.dev.yml (ports on 127.0.0.1). NEVER set this on the server.
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
