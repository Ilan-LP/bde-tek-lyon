# Build context = the whole repo (pnpm needs the root lockfile). Keep it small and free of secrets.
**/node_modules
**/dist
.git
.claude

# Secrets: never baked into an image. Config comes from the environment at run time
# (and from build args for the VITE_ values, see apps/web/Dockerfile).
.env
.env.*

# Uploaded images live in a volume, not in the image.
**/uploads

# Regenerated by `prisma generate` inside the image.
apps/api/src/generated

# Not needed to build or run anything.
brand
*.log
.DS_Store
